PORT=3000
NODE_ENV=development

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://wagering_user:wagering_password@localhost:5432/wagering_db

# AWS LocalStack SQS
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Configurações de Concorrência e Workers
OUTBOX_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_POLL_INTERVAL_MS=3000
PENDING_REFERENCE_MAX_ATTEMPTS=5
